# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Master key that encrypts every stored private key and API key: 64 hex characters.
# Generate with: openssl rand -hex 32
# Keep it apart from the wallet store file and back up both; losing it loses every stored wallet.
WALLET_ENCRYPTION_KEY=

# Encrypted wallet store (owner-only, git-ignored). Default: data/wallets.json
# WALLET_STORE_PATH=data/wallets.json

# Optional: comma-separated numeric Telegram user IDs. Leave unset for a public bot.
# ALLOWED_TELEGRAM_USER_IDS=

# Defaults to production (Solana mainnet).
# HEDGE_API_BASE_URL=https://hedgin.xyz

# Override only for a non-production deployment of the program.
# HEDGE_PROGRAM_ID=r2ahBQ6gbPCJ9FxBymYcXuwXi8NmenRry7SE7QR7FAt

