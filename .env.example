# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot. Everyone else is ignored.
ALLOWED_TELEGRAM_USER_IDS=
# Hedge Vault app origin. The bot calls <origin>/api/external/v1.
HEDGE_API_BASE_URL=https://hedgin.xyz
# Manager bot API key from the admin dashboard (hv1_<id>_<secret>).
HEDGE_API_KEY=
